      "updated": 1786200958248,
      "link": null,
      "locked": false,
      "text": "ROUND, UNTHREADED",
      "originalText": "ROUND, UNTHREADED",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 2,
      "versionNonce": 942517510,
      "index": "b0f",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e105",
      "type": "text",
      "x": 614,
      "y": 293.94,
      "width": 256,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786200958248,
      "link": null,
      "locked": false,
      "text": "Clip nut (snap-on).\nCommon on 2-post relay racks.",
      "originalText": "Clip nut (snap-on).\nCommon on 2-post relay racks.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 2,
      "versionNonce": 1821642330,
      "index": "b0g",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e106",
      "type": "text",
      "x": 150,
      "y": 826,
      "width": 700,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786200958248,
      "link": null,
      "locked": false,
      "text": "Square-hole rails let one cabinet host M6 gear this year and 10-32 gear next year - you change the cage nut, not the rack. A threaded rail\nis a decision you cannot undo: strip one hole and that U is gone, because you must never re-drill or re-tap a rack rail.",
      "originalText": "Square-hole rails let one cabinet host M6 gear this year and 10-32 gear next year - you change the cage nut, not the rack. A threaded rail\nis a decision you cannot undo: strip one hole and that U is gone, because you must never re-drill or re-tap a rack rail.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 2,
      "versionNonce": 1631460422,
      "index": "b0h",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
