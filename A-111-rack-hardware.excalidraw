      "updated": 1786374289880,
      "link": null,
      "locked": false,
      "text": "THE 0.17 mm THAT EATS RACKS:  10-32 is 4.83 mm.  M5 is 5.00 mm.",
      "originalText": "THE 0.17 mm THAT EATS RACKS:  10-32 is 4.83 mm.  M5 is 5.00 mm.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 52,
