    },
    {
      "id": "e105",
      "type": "text",
      "x": 614,
      "y": 293.94,
      "width": 256,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786373962796,
      "link": null,
      "locked": false,
      "text": "Clip nut (snap-on).\nCommon on 2-post relay racks.",
      "originalText": "Clip nut (snap-on).\nCommon on 2-post relay racks.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 2,
      "versionNonce": 256256081,
      "index": "b0g",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e106",
      "type": "text",
      "x": 150,
      "y": 826,
      "width": 655.7142857142857,
      "height": 41.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786375135716,
      "link": null,
      "locked": false,
      "text": "Square-hole rails let one rack host M6 gear this year and 10-32 gear next year - you change the cage\nnut, not the rail. A threaded rail is a decision you cannot undo: strip one hole and that U is gone,\nbecause you must never re-drill or re-tap a rack rail.",
      "originalText": "Square-hole rails let one rack host M6 gear this year and 10-32 gear next year - you change the cage nut, not the rail. A threaded rail is a decision you cannot undo: strip one hole and that U is gone, because you must never re-drill or re-tap a rack rail.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 75,
      "versionNonce": 1298488401,
      "index": "b0h",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
