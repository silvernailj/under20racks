      "index": "b37",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e257",
      "type": "text",
      "x": 164.8571428571429,
      "y": 1202.5714285714284,
      "width": 926,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786374289880,
      "link": null,
      "locked": false,
      "text": "An M5 screw will start in a 10-32 hole and feel almost right for two turns before it cuts the thread out of the rail. That U is then dead, and you cannot re-tap a\nrail. Sort your hardware into labeled bins on day one and never mix a bag. This single mistake accounts for more scrapped rails than everything else combined.",
      "originalText": "An M5 screw will start in a 10-32 hole and feel almost right for two turns before it cuts the thread out of the rail. That U is then dead, and you cannot re-tap a\nrail. Sort your hardware into labeled bins on day one and never mix a bag. This single mistake accounts for more scrapped rails than everything else combined.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 52,
      "versionNonce": 980122751,
      "index": "b38",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
