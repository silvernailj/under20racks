    {
      "id": "e336",
      "type": "text",
      "x": 1700,
      "y": 1328,
      "width": 260,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
