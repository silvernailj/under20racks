    {
      "id": "e336",
      "type": "text",
      "x": 1668.5714285714284,
      "y": 1326.5714285714287,
      "width": 340,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
