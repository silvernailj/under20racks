      "updated": 1786373962796,
      "link": null,
      "locked": false,
      "text": "ROUND, UNTHREADED",
      "originalText": "ROUND, UNTHREADED",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
