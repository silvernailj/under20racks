      "boundElements": [],
      "updated": 1786374090885,
      "link": null,
      "locked": false,
      "text": "Screw length matters in both directions. Too long bottoms out in the cage\nnut and clamps nothing; too short strips on the first turn. Match the length\nto the flange thickness.",
      "originalText": "Screw length matters in both directions. Too long bottoms out in the cage nut and clamps nothing; too short strips on the first turn. Match the length to the flange thickness.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 37,
