      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786294826766,
      "link": null,
      "locked": false,
      "text": "4. Combustible loading is a code limit under NFPA 75, not a housekeeping\npreference. No cardboard, no packing material, no paper stores.",
      "originalText": "4. Combustible loading is a code limit under NFPA 75, not a housekeeping preference. No cardboard, no packing material, no paper stores.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 411,
      "versionNonce": 1708838228,
      "index": "b3x",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
