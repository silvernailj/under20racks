      "text": "THE FAILURE THIS PREVENTS",
      "originalText": "THE FAILURE THIS PREVENTS",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 84,
