    },
    {
      "id": "e183",
      "type": "text",
      "x": 814,
      "y": 797,
      "width": 486.00000000000006,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786538371776,
      "link": null,
      "locked": false,
      "text": "NEC 645.10 has the EPO disconnect electronic equipment and the room's dedicated\nHVAC. It does not ask you to kill the lights, and killing egress lighting with it\nis a life-safety defect. In a small room fed from one panel that miswire is easy\nto build by accident and nobody finds it until the button is pressed in anger.",
      "originalText": "NEC 645.10 has the EPO disconnect electronic equipment and the room's dedicated HVAC. It does not ask you to kill the lights, and killing egress lighting with it is a life-safety defect. In a small room fed from one panel that miswire is easy to build by accident and nobody finds it until the button is pressed in anger.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 85,
      "versionNonce": 1963969507,
      "index": "b1w",
      "isDeleted": false,
