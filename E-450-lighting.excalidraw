      "roundness": null,
      "boundElements": [],
      "updated": 1786538371776,
      "link": null,
      "locked": false,
      "text": "The rack face is a VERTICAL surface. A design that\nonly proves a horizontal floor number can pass\ncalculation and still leave you holding a flashlight\nin your teeth at 02:00.",
      "originalText": "The rack face is a VERTICAL surface. A design that only proves a horizontal floor number can pass\ncalculation and still leave you holding a flashlight in your teeth at 02:00.",
