      "boundElements": [],
      "updated": 1786291831906,
      "link": null,
      "locked": false,
      "text": "Peak 67.3 A x 1.25 = 84 A -> 100 A main breaker and a 100 A feeder. Normal loading is 34 % of the main; the whole point of the second\ncolumn is that it is 67 % on the night the other side is out, and that is the number the panel has to be sized for.",
      "originalText": "Peak 67.3 A x 1.25 = 84 A -> 100 A main breaker and a 100 A feeder. Normal loading is 34 % of the main; the whole point of the second\ncolumn is that it is 67 % on the night the other side is out, and that is the number the panel has to be sized for.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 40,
