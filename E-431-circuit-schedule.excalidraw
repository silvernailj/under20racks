      "boundElements": [],
      "updated": 1786292376518,
      "link": null,
      "locked": false,
      "text": "Note space 2 is deliberately left empty. Filling a panel 1, 3, 5, 7 puts every circuit on the A-B and C-A\npairs and leaves B-C idle.\nSkipping one space shifts the second column onto the pairs the first column under-used, and the imbalance\nfalls from 20.0 % to 5.0 %.",
      "originalText": "Note space 2 is deliberately left empty. Filling a panel 1, 3, 5, 7 puts every circuit on the A-B and C-A pairs and leaves B-C idle.\nSkipping one space shifts the second column onto the pairs the first column under-used, and the imbalance falls from 20.0 % to 5.0 %.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 62,
