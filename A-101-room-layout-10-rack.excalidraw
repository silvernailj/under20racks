      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786111381232,
      "link": null,
      "locked": false,
      "text": "4. Rack rows run PERPENDICULAR to the fan-coil\ndischarge so supply air enters the cold aisle end-on.",
      "originalText": "4. Rack rows run PERPENDICULAR to the fan-coil discharge so supply air enters the cold aisle end-on.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
