      "updated": 1786111381232,
      "link": null,
      "locked": false,
      "text": "1. All dimensions are to finished face of rack or wall.",
      "originalText": "1. All dimensions are to finished face of rack or wall.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 44,
