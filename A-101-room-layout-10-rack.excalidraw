    },
    {
      "id": "e202",
      "type": "text",
      "x": 955.8928571428578,
      "y": 810.1428571428572,
      "width": 379.84374999999886,
      "height": 54.99999999999996,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786111381232,
      "link": null,
      "locked": false,
      "text": "2. Aisle pitch of 14'-0\" derives from a 7-tile module: 2\ntiles cold aisle + 42\" rack + 3'-0\" hot aisle + 42\"\nrack. Hold this module even on slab so a future raised\nfloor or containment kit drops in.",
      "originalText": "2. Aisle pitch of 14'-0\" derives from a 7-tile module: 2 tiles cold aisle + 42\" rack + 3'-0\" hot aisle + 42\" rack. Hold this module even on slab so a future raised floor or containment kit drops in.",
      "fontSize": 10.999999999999991,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 264,
      "versionNonce": 8183592,
      "index": "b2F",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e203",
      "type": "text",
      "x": 955.8928571428571,
      "y": 873.8928571428572,
      "width": 402.49999999999994,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786111381232,
      "link": null,
      "locked": false,
      "text": "3. Provide blanking panels in every unused U and brush\ngrommets at all rack cable entries before turnover.",
      "originalText": "3. Provide blanking panels in every unused U and brush grommets at all rack cable entries before turnover.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 99,
      "versionNonce": 1860614696,
      "index": "b2G",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
