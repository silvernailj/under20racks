      "type": "text",
      "x": 958.3928571428571,
      "y": 915.1428571428572,
      "width": 381.25000000000006,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
