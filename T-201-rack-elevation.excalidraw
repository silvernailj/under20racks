      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786207651105,
      "link": null,
      "locked": false,
      "text": "8. Bond the rack to the TGB with a #6 AWG rack bonding\nconductor. Paint-piercing washers or a scraped, listed\ncontact surface — a screw into painted steel is not a bond.",
      "originalText": "8. Bond the rack to the TGB with a #6 AWG rack bonding conductor. Paint-piercing washers or a scraped, listed contact surface — a screw into painted steel is not a bond.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 14,
      "versionNonce": 878072198,
      "index": "b1A",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e136",
      "type": "text",
      "x": 770,
      "y": 876,
      "width": 452.47897698884344,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
