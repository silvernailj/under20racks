      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786207837662,
      "link": null,
      "locked": false,
      "text": "9. Label both ends of every cord and cable per TIA-606-D before\nenergizing. Retro-labeling never happens.",
      "originalText": "9. Label both ends of every cord and cable per TIA-606-D before energizing. Retro-labeling never happens.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
