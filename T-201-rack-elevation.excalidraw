      "boundElements": [],
      "updated": 1786207622867,
      "link": null,
      "locked": false,
      "text": "6. Rack doors shall be at least 63% open area front and rear;\na glass front door on a populated rack is a cooling fault.",
      "originalText": "6. Rack doors shall be at least 63% open area front and rear; a glass front door on a populated rack is a cooling fault.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 18,
      "versionNonce": 399594630,
      "index": "b18",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e134",
      "type": "text",
      "x": 769.4969297446557,
      "y": 789.0369674223031,
      "width": 435.0308683643381,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786207642321,
      "link": null,
      "locked": false,
      "text": "7. Maintain 1.5\" min clearance between equipment faces and\nthe doors.",
      "originalText": "7. Maintain 1.5\" min clearance between equipment faces and the doors.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 179,
      "versionNonce": 252965894,
      "index": "b19",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e135",
      "type": "text",
      "x": 770,
      "y": 824,
      "width": 433.01850443751346,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
