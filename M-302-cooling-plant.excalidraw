      "boundElements": [],
      "updated": 1786303355162,
      "link": null,
      "locked": false,
      "text": "1. Cooling is fed from the mechanical panel,\nahead of the UPS but downstream of the ATS.\nCompressors do not belong on a UPS - but the\nroom cooks in minutes without them, so they\nmust be on the generator.",
      "originalText": "1. Cooling is fed from the mechanical panel, ahead of the UPS but downstream of the ATS. Compressors do not belong on a UPS - but the room cooks in minutes without them, so they must be on the generator.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
