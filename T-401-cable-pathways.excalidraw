    {
      "id": "e309",
      "type": "text",
      "x": 1374.8301808434048,
      "y": 702.0214562596018,
      "width": 317.4851997285923,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
