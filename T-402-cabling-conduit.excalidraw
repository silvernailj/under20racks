      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303756922,
      "link": null,
      "locked": false,
      "text": "!  ONE cable is allowed 53 % fill; TWO cables are limited to 31 %; three or more get 40 %. The two-cable case is the one people get wrong.",
      "originalText": "!  ONE cable is allowed 53 % fill; TWO cables are limited to 31 %; three or more get 40 %. The two-cable case is the one people get wrong.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 30,
      "versionNonce": 1721145812,
      "index": "b1m",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e174",
      "type": "text",
      "x": 162,
      "y": 1158,
      "width": 876,
      "height": 13.12,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303756922,
      "link": null,
      "locked": false,
      "text": "!  The DESIGN column is 60 % of the geometric count. Geometry is not the binding constraint - pulling tension and friction are.",
      "originalText": "!  The DESIGN column is 60 % of the geometric count. Geometry is not the binding constraint - pulling tension and friction are.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 30,
      "versionNonce": 1729600876,
      "index": "b1n",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
