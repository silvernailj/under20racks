    {
      "id": "e173",
      "type": "text",
      "x": 162,
      "y": 1130,
      "width": 876,
      "height": 13.12,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
