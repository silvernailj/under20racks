      "roundness": null,
      "boundElements": [],
      "updated": 1786303892865,
      "link": null,
      "locked": false,
      "text": "-  TIA-569 practice - no more than TWO 90 deg bends between pull points, and a pull point at least every 100 ft (30 m). That\nis the number to design to.",
      "originalText": "-  TIA-569 practice - no more than TWO 90 deg bends between pull points, and a pull point at least every 100 ft (30 m). That is the number to design to.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 26,
      "versionNonce": 512822740,
      "index": "b24",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e192",
      "type": "text",
      "x": 1130,
      "y": 1180,
      "width": 770.4705219358204,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303889330,
      "link": null,
      "locked": false,
      "text": "-  Pull box, straight pull - NEC 314.28(A)(1): length at least 8 x the trade size of the largest raceway. A 2 in conduit\nneeds a 16 in box.",
      "originalText": "-  Pull box, straight pull - NEC 314.28(A)(1): length at least 8 x the trade size of the largest raceway. A 2 in conduit needs a 16 in box.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 29,
      "versionNonce": 1587288172,
      "index": "b25",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e193",
      "type": "text",
      "x": 1130,
      "y": 1222,
      "width": 778.4711010393596,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303884224,
      "link": null,
      "locked": false,
      "text": "-  Pull box, angle or U pull - NEC 314.28(A)(2): at least 6 x the trade size, plus the sum of the other raceway diameters in\nthe same row.",
      "originalText": "-  Pull box, angle or U pull - NEC 314.28(A)(2): at least 6 x the trade size, plus the sum of the other raceway diameters in the same row.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 50,
      "versionNonce": 1738358612,
      "index": "b26",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e194",
      "type": "text",
      "x": 1130,
      "y": 1264,
      "width": 763.4113744754202,
      "height": 13.125,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
