      "updated": 1786303640148,
      "link": null,
      "locked": false,
      "text": "ToR  -  switch pair in every rack, fiber uplinks only. Least copper between racks. Right for dense, uniform racks.",
      "originalText": "ToR  -  switch pair in every rack, fiber uplinks only. Least copper between racks. Right for dense, uniform racks.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 2,
      "versionNonce": 93654868,
      "index": "ar",
      "isDeleted": false,
      "seed": 1,
      "autoResize": true
    },
    {
      "id": "e55",
      "type": "text",
      "x": 162,
      "y": 700,
      "width": 752.5886255245798,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303726417,
      "link": null,
      "locked": false,
      "text": "MoR / EoR  -  one switch pair serves the row from A03. Fewer switches, better port use, larger copper bundles converging\non one rack. Right for ten mixed, low-density racks - and the case drawn above.",
      "originalText": "MoR / EoR  -  one switch pair serves the row from A03. Fewer switches, better port use, larger copper bundles converging on one rack. Right for ten mixed, low-density racks - and the case drawn above.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 15,
      "versionNonce": 1474764012,
      "index": "as",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
