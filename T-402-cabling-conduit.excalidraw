      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303879409,
      "link": null,
      "locked": false,
      "text": "-  Telecom pull boxes are pull-THROUGH only. No splices, no stored cable, no sharp internal corners.",
      "originalText": "-  Telecom pull boxes are pull-THROUGH only. No splices, no stored cable, no sharp internal corners.",
      "fontSize": 10.5,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 69,
