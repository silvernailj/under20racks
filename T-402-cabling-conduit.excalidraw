      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786303787970,
      "link": null,
      "locked": false,
      "text": "!  JAM RATIO: where conduit ID divided by cable OD falls between 2.8 and 3.2, three same-size cables can wedge and stop the pull. Size around\nit.",
      "originalText": "!  JAM RATIO: where conduit ID divided by cable OD falls between 2.8 and 3.2, three same-size cables can wedge and stop the pull. Size around it.",
      "fontSize": 10.5,
      "fontFamily": 3,
