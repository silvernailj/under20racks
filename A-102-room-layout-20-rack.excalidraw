      "updated": 1786152978629,
      "link": null,
      "locked": false,
      "text": "1. 20 racks at 640 sq ft = 32 sq ft/rack.\nBelow ~25 sq ft/rack a small room stops being\nserviceable.",
      "originalText": "1. 20 racks at 640 sq ft = 32 sq ft/rack. Below ~25 sq ft/rack a small room stops being serviceable.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 315,
      "versionNonce": 857515398,
      "index": "b3K",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e485",
      "type": "text",
      "x": 1231.6640858244393,
      "y": 831.3092705949565,
      "width": 342.95133143887125,
      "height": 46.314372761979364,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786152978629,
      "link": null,
      "locked": false,
      "text": "2. Containment roof panels shall drop away on a\nfusible link or on the suppression release so\nthe clean agent floods the whole room volume.",
      "originalText": "2. Containment roof panels shall drop away on a fusible link or on the suppression release so the clean agent floods the whole room volume.",
      "fontSize": 12.350499403194497,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 828,
      "versionNonce": 79299782,
      "index": "b3L",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
    {
      "id": "e486",
      "type": "text",
      "x": 1231.6640858244393,
      "y": 894.0150725173976,
      "width": 357.0102046711344,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786152978629,
      "link": null,
      "locked": false,
      "text": "3. With containment, size suppression on the FULL\nroom volume, not the aisle volume.",
      "originalText": "3. With containment, size suppression on the FULL room volume, not the aisle volume.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "version": 394,
      "versionNonce": 1374256134,
      "index": "b3M",
      "isDeleted": false,
      "seed": 1,
      "autoResize": false
    },
