      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786152978629,
      "link": null,
      "locked": false,
      "text": "4. Do not gap the row for mid-row access; it\nshort-circuits containment. Use the end-of-row\nroute instead.",
      "originalText": "4. Do not gap the row for mid-row access; it short-circuits containment. Use the end-of-row route instead.",
